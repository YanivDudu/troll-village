{
 "firestore": {
  "rules": "firestore.rules"
 },
 "database": {
  "rules": "database.rules.json"
 },
 "hosting": {
  "public": ".",
  "ignore": [
   "firebase.json",
   "*.rules",
   "*.rules.json",
   "**/.*",
   "**/node_modules/**",
   "docs/**",
   "tests/**",
   "shots/**",
   "**/*.md",
   "**/*.py"
  ],
  "headers": [
   {
    "source": "**/*.@(html|js)",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   }
  ]
 }
}
