{
 "firestore": {
  "rules": "firestore.rules"
 },
 "database": {
  "rules": "database.rules.json"
 },
 "hosting": {
  "public": ".",
  "ignore": [
   "firebase.json",
   "*.rules",
   "*.rules.json",
   ".!(well-known)",
   ".!(well-known)/**",
   "*/**/.*",
   "*/**/.*/**",
   "tools/**",
   "**/node_modules/**",
   "docs/**",
   "tests/**",
   "shots/**",
   "spike/**",
   "**/*.md",
   "**/*.py",
   "**/*.log"
  ],
  "headers": [
   {
    "source": "@(sw.js|manifest.webmanifest)",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "**/*.@(html|js)",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "/",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   }
  ]
 }
}